# =============================================
# .env.example — Mẫu biến môi trường
# Sao chép file này thành .env và điền giá trị thật
# KHÔNG đặt mật khẩu thật vào file này!
# =============================================

# --- MySQL Database ---
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=wordpress_db
MYSQL_USER=wp_user
MYSQL_PASSWORD=your_wp_password_here

# --- WordPress ---
WORDPRESS_DB_HOST=db:3306
WORDPRESS_DB_NAME=wordpress_db
WORDPRESS_DB_USER=wp_user
WORDPRESS_DB_PASSWORD=your_wp_password_here

# Table prefix (thay đổi để bảo mật, mặc định là wp_)
WORDPRESS_TABLE_PREFIX=wpsec_

# Debug mode (false cho production)
WORDPRESS_DEBUG=false

# --- phpMyAdmin ---
PMA_HOST=db
PMA_PORT=3306

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your_grafana_password_here

# --- Prometheus ---
PROMETHEUS_RETENTION=15d

# --- MySQL exporter (quyền chỉ đọc) ---
MYSQL_EXPORTER_USER=exporter
MYSQL_EXPORTER_PASSWORD=your_exporter_password_here
